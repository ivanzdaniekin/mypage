name = "ivan-praca-leads"
main = "worker.mjs"
compatibility_date = "2026-11-01"
workers_dev = true
[vars]
ENABLED = "false"
TEST_ONLY = "true"
PRIVACY_APPROVED = "false"
PRIVACY_VERSION = ""
# APPS_SCRIPT_URL is an existing Secret, not a plaintext variable.
[[d1_databases]]
binding = "DB"
database_name = "ivan-praca-leads-db"
database_id = "7f133043-db01-46b5-8c65-30fe059c1edd"
[triggers]
crons = ["0 3 * * *"]
[observability]
enabled = false
